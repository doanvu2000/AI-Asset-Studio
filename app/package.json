{
  "name": "ai-asset-studio",
  "productName": "AI Asset Studio",
  "version": "0.1.0",
  "private": true,
  "description": "AI Asset Studio desktop shell",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:mock": "electron-vite dev --mode mock",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "dist:core": "uv --directory ../core run pyinstaller packaging/studio-core.spec --noconfirm --clean",
    "dist:app": "node -e \"require('fs').statSync('../core/dist/studio-core/studio-core.exe')\" && electron-vite build && electron-builder --win --x64",
    "dist": "npm run dist:core && npm run dist:app",
    "dist:portable": "electron-vite build && electron-builder --win dir --x64"
  },
  "dependencies": {
    "@esotericsoftware/spine-player": "4.2.43",
    "@fontsource-variable/inter": "^5.3.0",
    "@formkit/auto-animate": "^0.10.0",
    "@lucide/vue": "^1.59.0",
    "@tanstack/vue-virtual": "^3.13.47",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "@vueuse/core": "^15.0.0",
    "motion-v": "^2.8.0",
    "pinia": "^4.1.0",
    "three": "0.186.1",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "electron": "^44.9.0",
    "electron-builder": "26.15.3",
    "electron-vite": "^6.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vue-tsc": "^3.3.13"
  }
}
