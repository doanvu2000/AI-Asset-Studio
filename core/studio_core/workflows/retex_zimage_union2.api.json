  "5": {"class_type": "LoadImage", "inputs": {"image": "retex_depth.png"}, "_meta": {"title": "Depth"}},
  "6": {"class_type": "LoadImage", "inputs": {"image": "retex_inpaint.png"}, "_meta": {"title": "Known render"}},
  "7": {"class_type": "LoadImageMask", "inputs": {"image": "retex_mask.png", "channel": "red"},
        "_meta": {"title": "Repaint mask"}},
  "8": {"class_type": "ZImageFunControlnet",
        "inputs": {"model": ["1", 0], "model_patch": ["4", 0], "vae": ["3", 0], "strength": 0.85,
                   "image": ["5", 0], "inpaint_image": ["6", 0], "mask": ["7", 0]},
        "_meta": {"title": "Fun ControlNet Union 2.0 (depth + inpaint)"}},
  "9": {"class_type": "ModelSamplingAuraFlow", "inputs": {"shift": 3, "model": ["8", 0]},
        "_meta": {"title": "ModelSamplingAuraFlow"}},
  "10": {"class_type": "CLIPTextEncode", "inputs": {"text": "a wooden crate", "clip": ["2", 0]},
