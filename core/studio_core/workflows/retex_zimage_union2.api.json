  "12": {"class_type": "VAEEncode", "inputs": {"pixels": ["6", 0], "vae": ["3", 0]}, "_meta": {"title": "VAE Encode"}},
  "13": {"class_type": "SetLatentNoiseMask", "inputs": {"samples": ["12", 0], "mask": ["7", 0]},
         "_meta": {"title": "Set Latent Noise Mask"}},
  "14": {"class_type": "KSampler",
         "inputs": {"seed": 1, "steps": 10, "cfg": 1, "sampler_name": "res_multistep", "scheduler": "simple",
                    "denoise": 1, "model": ["9", 0], "positive": ["10", 0], "negative": ["11", 0],
                    "latent_image": ["13", 0]},
         "_meta": {"title": "KSampler"}},
  "15": {"class_type": "VAEDecode", "inputs": {"samples": ["14", 0], "vae": ["3", 0]}, "_meta": {"title": "VAE Decode"}},
  "16": {"class_type": "SaveImage", "inputs": {"filename_prefix": "retex", "images": ["15", 0]},
